# Copy to .env and fill in the providers you actually use.
# resources/models.toml declares three models (summary, cv, highlight) and
# names the key variable each one needs. A model whose variable is empty
# borrows the endpoint of one that is set, so a single provider key is enough
# to get going.

# --- Alibaba DashScope (Qwen) — where models.toml points as shipped ----------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- DeepSeek ----------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Local model via Ollama --------------------------------------------------
# Ollama ignores the key but the OpenAI client requires a non-empty one.
# OLLAMA_API_KEY=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Paths -------------------------------------------------------------------
# Workspace the watcher polls and writes into (default: ~/jobstitch).
# JOBSTITCH_HOME=~/jobstitch
# Templates, prompts, models.toml and your CV data (default: ./resources).
# JOBSTITCH_RESOURCES=/path/to/resources

# --- Docker (compose.yaml reads these; ignored when you run jobstitch directly)
# The folder mounted at /data, holding applications_cv/ and resources/.
# JOBSTITCH_DATA=/path/to/jobstitch-data
# Run the container as you, so the files it writes are yours: id -u / id -g.
# JOBSTITCH_UID=1000
# JOBSTITCH_GID=1000
# Set to off to run the watcher without the clipboard intake process.
# JOBSTITCH_CLIPBOARD=on
# The X11 magic cookie, so the container may talk to your display. Needed by
# every SSH-forwarded display and by most local ones. Absolute path, no ~:
# JOBSTITCH_XAUTHORITY=/home/you/.Xauthority
# Only over SSH with X11 forwarding (DISPLAY=localhost:10.0 and the like):
# the display is a TCP port on the host's loopback, which a bridged container
# cannot reach. Set together with JOBSTITCH_XAUTHORITY above, never alone.
# JOBSTITCH_NETWORK=host
