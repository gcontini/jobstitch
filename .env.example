# Server configuration. Copy to .env and fill in the provider you use.
#
# This file is for the SERVER only — the client never needs an API key.
# server/src/jobstitch_server/resources/models.toml declares three models
# (summary, cv, highlight) and names the key variable each one needs. A model
# whose variable is empty borrows the endpoint of one that is set, so a single
# provider key is enough to get going.

# --- Alibaba DashScope (Qwen) — where models.toml points as shipped ----------
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- DeepSeek ----------------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Local model via Ollama --------------------------------------------------
# Ollama ignores the key but the OpenAI client requires a non-empty one.
# OLLAMA_API_KEY=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Server ------------------------------------------------------------------
# Require this bearer token on every /v1 call. Unset means the server is open
# to anyone who can reach it.
# JOBSTITCH_API_TOKEN=
# Requests in flight before the server answers 429 (default 10).
# JOBSTITCH_MAX_CONCURRENT_JOBS=10
# Wall clock for one CV run before it gives up (default 1200s).
# JOBSTITCH_REQUEST_BUDGET_SECONDS=1200
# Replacement prompts / template / models.toml (default: baked into the image).
# JOBSTITCH_RESOURCES=/path/to/resources
# Where per-request scratch directories are made (default: the system temp dir).
# JOBSTITCH_WORK_DIR=/tmp/jobstitch
# Port uvicorn listens on (default 8080; most platforms inject this).
# PORT=8080

# --- Client ------------------------------------------------------------------
# The client reads these too, but jobstitch.toml next to the binary is the
# usual way (see client/README.md).
# JOBSTITCH_API_URL=http://localhost:8080
