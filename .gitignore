# --- Secrets ----------------------------------------------------------------
.env
# The client's own configuration: it holds a bearer token.
jobstitch.toml

# --- Your data --------------------------------------------------------------
# The fictional set in examples/candidate/ is committed; yours is not. Keep
# your real files next to the client binary, outside the checkout.
/candidate_profile.json
/candidate_data.json
/pers_preferences.md
/candidate_signature.png

# --- Output -----------------------------------------------------------------
# Anything a run produced: CVs, spreadsheets, scratch folders.
/applications/
/out/
/jobstitch-data/*
!/jobstitch-data/.gitkeep

# --- Python -----------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/
